[Unit]
Description=HyperFileLens Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/opt/hyperfilelens-agent/config/agent.env
WorkingDirectory=/opt/hyperfilelens-agent/bin
ExecStart=/opt/hyperfilelens-agent/bin/hfl-agent run
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
