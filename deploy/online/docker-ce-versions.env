# Docker CE apt package pins used only by the Community online installer.
# Keep one set per supported Ubuntu release that is available from both the
# Docker CE and Alibaba Cloud Docker CE repositories. These pins are deliberately
# separate from tools/dependencies/versions/docker-ce.env, which is consumed by
# the offline release builder and must continue to target its own host matrix.

UBUNTU2004_ENGINE_VERSION=5:28.1.1-1~ubuntu.20.04~focal
UBUNTU2004_CLI_VERSION=5:28.1.1-1~ubuntu.20.04~focal
UBUNTU2004_CONTAINERD_VERSION=1.7.27-1
UBUNTU2004_COMPOSE_PLUGIN_VERSION=2.35.1-1~ubuntu.20.04~focal

UBUNTU2204_ENGINE_VERSION=5:29.2.1-1~ubuntu.22.04~jammy
UBUNTU2204_CLI_VERSION=5:29.2.1-1~ubuntu.22.04~jammy
UBUNTU2204_CONTAINERD_VERSION=2.2.1-1~ubuntu.22.04~jammy
UBUNTU2204_COMPOSE_PLUGIN_VERSION=5.0.2-1~ubuntu.22.04~jammy

UBUNTU2404_ENGINE_VERSION=5:29.2.1-1~ubuntu.24.04~noble
UBUNTU2404_CLI_VERSION=5:29.2.1-1~ubuntu.24.04~noble
UBUNTU2404_CONTAINERD_VERSION=2.2.1-1~ubuntu.24.04~noble
UBUNTU2404_COMPOSE_PLUGIN_VERSION=5.0.2-1~ubuntu.24.04~noble
