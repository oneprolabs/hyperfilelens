--- a/internal/cache/demand_driven_test.go
+++ b/internal/cache/demand_driven_test.go
@@ -0,0 +1,27 @@
+package cache
+
+import (
+	"context"
+	"testing"
+)
+
+func TestDemandDrivenKeepsCachingEnabledWithoutCapacityEviction(t *testing.T) {
+	ctx := context.Background()
+	legacy, err := NewStorageOrNil(ctx, t.TempDir(), 0, "contents")
+	if err != nil || legacy != nil {
+		t.Fatal("legacy zero must disable caching")
+	}
+	managed, err := NewStorageWithPolicy(ctx, t.TempDir(), 0, "contents", true)
+	if err != nil || managed == nil {
+		t.Fatal("demand-driven zero must keep caching enabled")
+	}
+	c := &PersistentCache{sweep: SweepSettings{DemandDriven: true, MaxSizeBytes: 1, LimitBytes: 1}}
+	c.listCache.totalDataBytes = 1000000
+	if c.aboveSoftLimit(1) || c.aboveHardLimit(1) {
+		t.Fatal("demand-driven cache retained a capacity limit")
+	}
+	c.sweep.DemandDriven = false
+	if !c.aboveSoftLimit(1) || !c.aboveHardLimit(1) {
+		t.Fatal("legacy fixed limits changed")
+	}
+}
