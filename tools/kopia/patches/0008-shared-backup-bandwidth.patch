+++ b/internal/hflquota/quota_test.go
@@ -0,0 +1,117 @@
+package hflquota
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/kopia/kopia/internal/gather"
+	"github.com/kopia/kopia/repo/blob"
+	"google.golang.org/grpc/metadata"
+)
+
+func configure(t *testing.T, handler http.HandlerFunc) *httptest.Server {
+	t.Helper()
+	server := httptest.NewServer(handler)
+	t.Cleanup(server.Close)
+	t.Setenv("HFL_BACKUP_QUOTA_URL", server.URL)
+	t.Setenv("HFL_BACKUP_QUOTA_TOKEN", strings.Repeat("a", 64))
+	t.Setenv("HFL_BACKUP_QUOTA_TASK", "backup")
+	return server
+}
+
+func TestQuotaRetriesExhaustionAndFailsOpenOnFailure(t *testing.T) {
+	calls := 0
+	configure(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("X-HFL-Quota-Token") != strings.Repeat("a", 64) {
+			t.Error("missing local auth")
+		}
+		calls++
+		var request struct {
+			Bytes int `json:"bytes"`
+		}
+		_ = json.NewDecoder(r.Body).Decode(&request)
+		grant := request.Bytes
+		if calls < 3 {
+			grant = 0
+		}
+		_ = json.NewEncoder(w).Encode(map[string]int{"granted": grant, "retry_ms": 10})
+	})
+	Wait(context.Background(), chunk+10)
+	if calls != 4 {
+		t.Fatalf("calls=%d", calls)
+	}
+	configure(t, func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(http.StatusServiceUnavailable) })
+	start := time.Now()
+	Wait(context.Background(), chunk)
+	if time.Since(start) > time.Second {
+		t.Fatal("failure blocked backup")
+	}
+	t.Setenv("HFL_BACKUP_QUOTA_URL", "https://external.example")
+	Wait(context.Background(), chunk) // Never sends Agent IPC credentials off-host.
+}
+
+type storageSink struct {
+	blob.Storage
+	data []byte
+}
+
+func (s *storageSink) PutBlob(_ context.Context, _ blob.ID, data blob.Bytes, _ blob.PutOptions) error {
+	r := data.Reader()
+	defer r.Close()
+	s.data, _ = io.ReadAll(r)
+	return nil
+}
+
+func TestStoragePacingPreservesDataAndUnmanagedBehavior(t *testing.T) {
+	bytes := 0
+	configure(t, func(w http.ResponseWriter, r *http.Request) {
+		var request struct {
+			Bytes int `json:"bytes"`
+		}
+		_ = json.NewDecoder(r.Body).Decode(&request)
+		bytes += request.Bytes
+		_ = json.NewEncoder(w).Encode(map[string]int{"granted": request.Bytes})
+	})
+	t.Setenv("HFL_BACKUP_DATA", "1")
+	sink := &storageSink{}
+	data := []byte(strings.Repeat("backup", 20000))
+	if err := Wrap(sink).PutBlob(context.Background(), "p1", gather.FromSlice(data), blob.PutOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	if string(sink.data) != string(data) || bytes != len(data) {
+		t.Fatal("changed backup bytes or accounting")
+	}
+	t.Setenv("HFL_BACKUP_DATA", "")
+	if Wrap(sink) != sink {
+		t.Fatal("unmanaged storage wrapped")
+	}
+}
+
+func TestProxyPacesOnlyMarkedRepositoryDataWrites(t *testing.T) {
+	calls := 0
+	configure(t, func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		_ = json.NewEncoder(w).Encode(map[string]int{"granted": 10})
+	})
+	t.Setenv("HFL_BACKUP_QUOTA_MODE", "server")
+	ServerWrite(context.Background(), 10)
+	if calls != 0 {
+		t.Fatal("unmarked repository control write was throttled")
+	}
+	ctx := metadata.NewIncomingContext(context.Background(), metadata.Pairs("hfl-backup-data", "1"))
+	ServerWrite(ctx, 10)
+	if calls != 1 {
+		t.Fatal("marked repository backup write was not throttled")
+	}
+	t.Setenv("HFL_BACKUP_QUOTA_MODE", "")
+	ServerWrite(ctx, 10)
+	if calls != 1 {
+		t.Fatal("non-server process changed")
+	}
+}
