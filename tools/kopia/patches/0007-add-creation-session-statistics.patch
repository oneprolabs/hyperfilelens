+// HFLNewDataBytes returns newly admitted data-content lengths in this writer.
+// These are session metrics, not a source-history delta or storage billing total.
+func (bm *WriteManager) HFLNewDataBytes() (int64, int64) {
+	bm.mu.RLock()
+	defer bm.mu.RUnlock()
+	return bm.hflOriginalBytes, bm.hflPackedBytes
