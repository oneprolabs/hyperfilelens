+	var beforeOriginal, beforePacked int64
+	direct, supported := rep.(repo.DirectRepositoryWriter)
+	if supported {
+		supported = direct.ContentManager().SupportsContentCompression()
+		if supported {
+			beforeOriginal, beforePacked = direct.ContentManager().HFLNewDataBytes()
+		}
+	}
+
 	manifest, finalErr := u.Upload(ctx, fsEntry, policyTree, sourceInfo, previous...)
 	if finalErr != nil {
 		// fail-fast uploads will fail here without recording a manifest, other uploads will
 		// possibly fail later.
 		return errors.Wrap(finalErr, "upload error")
+	}
+
+	if supported {
+		original, packed := direct.ContentManager().HFLNewDataBytes()
+		manifest.HFLCreateStats = &snapshot.HFLCreateStats{
+			Version: 1, Basis: "creation_session_data_v1",
+			OriginalBytes: original - beforeOriginal,
+			PackedBytes:   packed - beforePacked,
+		}
 	}
 
 	manifest.Description = c.snapshotCreateDescription
