+func TestHFLCreateStatsPersistAndDeduplicate(t *testing.T) {
+	e := testenv.NewCLITest(t, testenv.RepoFormatNotImportant, testenv.NewInProcRunner(t))
+	e.RunAndExpectSuccess(t, "repo", "create", "filesystem", "--path", e.RepoDir)
+	source := testutil.TempDirectory(t)
+	data := bytes.Repeat([]byte("compressible backup content"), 10000)
+	require.NoError(t, os.WriteFile(filepath.Join(source, "a.txt"), data, 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(source, "duplicate.txt"), data, 0o600))
+	e.RunAndExpectSuccess(t, "policy", "set", "--compression=zstd", source)
+	var first snapshot.Manifest
+	testutil.MustParseJSONLines(t, e.RunAndExpectSuccess(t, "snapshot", "create", source, "--json"), &first)
+	require.NotNil(t, first.HFLCreateStats)
+	require.Equal(t, int64(len(data)), first.HFLCreateStats.OriginalBytes)
+	require.Positive(t, first.HFLCreateStats.PackedBytes)
+	require.Less(t, first.HFLCreateStats.PackedBytes, first.HFLCreateStats.OriginalBytes)
+	require.Equal(t, int64(2*len(data)), first.RootEntry.DirSummary.TotalFileSize)
+	var second snapshot.Manifest
+	testutil.MustParseJSONLines(t, e.RunAndExpectSuccess(t, "snapshot", "create", source, "--json"), &second)
+	require.NotNil(t, second.HFLCreateStats)
+	require.Zero(t, second.HFLCreateStats.OriginalBytes)
+	require.Zero(t, second.HFLCreateStats.PackedBytes)
+	var history []*snapshot.Manifest
+	testutil.MustParseJSONLines(t, e.RunAndExpectSuccess(t, "snapshot", "list", source, "--json", "--no-retention"), &history)
+	require.Len(t, history, 2)
+	require.Equal(t, first.HFLCreateStats, history[0].HFLCreateStats)
+	require.Equal(t, second.HFLCreateStats, history[1].HFLCreateStats)
+	other := testutil.TempDirectory(t)
+	require.NoError(t, os.WriteFile(filepath.Join(other, "shared.txt"), data, 0o600))
+	var shared snapshot.Manifest
+	testutil.MustParseJSONLines(t, e.RunAndExpectSuccess(t, "snapshot", "create", other, "--json"), &shared)
+	require.Zero(t, shared.HFLCreateStats.OriginalBytes)
+	require.Zero(t, shared.HFLCreateStats.PackedBytes)
+}
+
+func TestHFLCreateStatsSeparateSourcesInOneSession(t *testing.T) {
+	e := testenv.NewCLITest(t, testenv.RepoFormatNotImportant, testenv.NewInProcRunner(t))
+	e.RunAndExpectSuccess(t, "repo", "create", "filesystem", "--path", e.RepoDir)
+	a, b := testutil.TempDirectory(t), testutil.TempDirectory(t)
+	da, db := []byte("source A unique bytes"), []byte("other unique source B bytes")
+	require.NoError(t, os.WriteFile(filepath.Join(a, "a"), da, 0o600))
+	require.NoError(t, os.WriteFile(filepath.Join(b, "b"), db, 0o600))
+	var results []*snapshot.Manifest
+	output := e.RunAndExpectSuccess(t, "snapshot", "create", a, b, "--json")
+	decoder := json.NewDecoder(strings.NewReader(strings.Join(output, "\n")))
+	for range 2 {
+		var result snapshot.Manifest
+		require.NoError(t, decoder.Decode(&result))
+		results = append(results, &result)
+	}
+	require.Len(t, results, 2)
+	require.Equal(t, int64(len(da)), results[0].HFLCreateStats.OriginalBytes)
+	require.Equal(t, int64(len(db)), results[1].HFLCreateStats.OriginalBytes)
+}
