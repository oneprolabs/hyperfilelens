+func (s *contentManagerSuite) TestHFLCreateStatsConcurrentAdmissions(t *testing.T) {
+	ctx := testlogging.Context(t)
+	bm := s.newTestContentManager(t, blobtesting.NewMapStorage(blobtesting.DataMap{}, nil, nil))
+	defer bm.CloseShared(ctx)
+	data := []byte("same data chunk for all parallel file writers")
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := bm.WriteContent(ctx, gather.FromSlice(data), "", NoCompression)
+			if err != nil {
+				t.Error(err)
+			}
+		}()
+	}
+	wg.Wait()
+	original, packed := bm.HFLNewDataBytes()
+	require.Equal(t, int64(len(data)), original)
+	require.Positive(t, packed)
+	_, err := bm.WriteContent(ctx, gather.FromSlice(data), "k", NoCompression)
+	require.NoError(t, err)
+	require.NoError(t, bm.Flush(ctx))
+	o2, p2 := bm.HFLNewDataBytes()
+	require.Equal(t, original, o2)
+	require.Equal(t, packed, p2)
+	require.NoError(t, bm.Flush(ctx))
+	o3, p3 := bm.HFLNewDataBytes()
+	require.Equal(t, original, o3)
+	require.Equal(t, packed, p3)
+}
