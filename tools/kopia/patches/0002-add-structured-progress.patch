diff --git a/cli/cli_progress_hfl_test.go b/cli/cli_progress_hfl_test.go
new file mode 100644
index 00000000..b93e48c3
--- /dev/null
+++ b/cli/cli_progress_hfl_test.go
@@ -0,0 +1,74 @@
+package cli
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestHFLStructuredProgress(t *testing.T) {
+	var stderr bytes.Buffer
+
+	app := NewApp()
+	app.stderrWriter = &stderr
+
+	p := &cliProgress{
+		progressFlags: progressFlags{
+			progressFormat:         progressFormatHFLJSON,
+			progressUpdateInterval: time.Hour,
+		},
+	}
+	p.out.setup(app)
+
+	p.UploadStarted()
+	p.EstimatedDataSize(10, 4_130_621_356)
+	p.CachedFile("ignored", 3_208_296_249)
+	p.HashedBytes(270_077_614)
+	p.UploadedBytes(270_077_614)
+	p.Finish()
+	p.Complete()
+
+	lines := strings.Split(strings.TrimSpace(stderr.String()), "\n")
+	if len(lines) < 4 {
+		t.Fatalf("expected at least 4 progress events, got %d: %q", len(lines), stderr.String())
+	}
+
+	events := make([]hflProgressEvent, len(lines))
+	for i, line := range lines {
+		if err := json.Unmarshal([]byte(line), &events[i]); err != nil {
+			t.Fatalf("event %d is not valid JSON: %v", i, err)
+		}
+
+		if events[i].Sequence != int64(i+1) {
+			t.Fatalf("event %d has sequence %d", i, events[i].Sequence)
+		}
+	}
+
+	if events[0].Phase != "estimating" || events[0].EstimatedBytes != nil || events[0].PercentComplete != nil {
+		t.Fatalf("unexpected initial event: %+v", events[0])
+	}
+
+	finalizing := events[len(events)-2]
+	if finalizing.Phase != "finalizing" {
+		t.Fatalf("expected finalizing phase, got %q", finalizing.Phase)
+	}
+
+	if finalizing.ProcessedBytes != 3_478_373_863 || finalizing.UploadedBytes != 270_077_614 {
+		t.Fatalf("unexpected exact counters: %+v", finalizing)
+	}
+
+	if finalizing.EstimatedBytes == nil || *finalizing.EstimatedBytes != 4_130_621_356 {
+		t.Fatalf("unexpected estimated bytes: %+v", finalizing.EstimatedBytes)
+	}
+
+	if finalizing.PercentComplete == nil || *finalizing.PercentComplete < 84.20 || *finalizing.PercentComplete > 84.22 {
+		t.Fatalf("unexpected percent: %+v", finalizing.PercentComplete)
+	}
+
+	done := events[len(events)-1]
+	if done.Phase != "done" || done.PercentComplete == nil || *done.PercentComplete != 100 {
+		t.Fatalf("unexpected done event: %+v", done)
+	}
+}
