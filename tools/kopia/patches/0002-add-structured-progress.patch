+type hflProgressEvent struct {
+	Type             string   `json:"type"`
+	SchemaVersion    int      `json:"schema_version"`
+	Sequence         int64    `json:"sequence"`
+	SampledAt        string   `json:"sampled_at"`
+	Phase            string   `json:"phase"`
+	ProcessedBytes   int64    `json:"processed_bytes"`
+	EstimatedBytes   *int64   `json:"estimated_bytes"`
+	UploadedBytes    int64    `json:"uploaded_bytes"`
+	PercentComplete  *float64 `json:"percent_complete"`
+	ElapsedSeconds   float64  `json:"elapsed_seconds"`
+	RemainingSeconds *int64   `json:"remaining_seconds"`
+}
+
+// +checklocks:p.outputMutex
+func (p *cliProgress) outputHFLJSON(processedBytes, uploadedBytes int64) {
+	now := time.Now() //nolint:forbidigo
+	phase := "estimating"
+
+	if p.estimated {
+		phase = "processing"
+	}
+
+	if p.finalizing.Load() {
+		phase = "finalizing"
+	}
+
+	if p.uploadFinished.Load() {
+		phase = "done"
+	}
+
+	p.sequence++
+	event := hflProgressEvent{
+		Type:           hflProgressEventType,
+		SchemaVersion:  hflProgressSchema,
+		Sequence:       p.sequence,
+		SampledAt:      now.UTC().Format(time.RFC3339Nano),
+		Phase:          phase,
+		ProcessedBytes: processedBytes,
+		UploadedBytes:  uploadedBytes,
+		ElapsedSeconds: now.Sub(p.uploadStartedAt).Seconds(),
+	}
+
+	if phase == "done" {
+		percent := 100.0
+		event.PercentComplete = &percent
+	}
+
+	if p.estimated {
+		total := p.estimatedTotalBytes
+		event.EstimatedBytes = &total
+
+		if phase != "done" && total > 0 {
+			percent := 100 * float64(processedBytes) / float64(total)
+			if percent >= 100 {
+				percent = 99.99
+			}
+
+			event.PercentComplete = &percent
+
+			if phase == "processing" {
+				if est, ok := p.uploadStartTime.Estimate(float64(processedBytes), float64(total)); ok {
+					remaining := int64(est.Remaining / time.Second)
+					event.RemainingSeconds = &remaining
+				}
+			}
+		}
+	}
+
+	encoded, err := json.Marshal(event)
+	if err != nil {
+		return
+	}
+
+	p.out.printStderr("%s\n", encoded)
+}
