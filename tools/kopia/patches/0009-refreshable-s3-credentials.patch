+++ b/repo/blob/s3/credential_file.go
@@ -0,0 +1,70 @@
+package s3
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/minio/minio-go/v7/pkg/credentials"
+)
+
+// credentialFileProvider is deliberately outside the ordinary credential chain.
+// An expired, missing, or malformed lease must never fall back to environment
+// credentials or the instance identity.
+type credentialFileProvider struct {
+	path string
+}
+
+func (p *credentialFileProvider) Retrieve() (credentials.Value, error) {
+	return p.RetrieveWithCredContext(nil)
+}
+
+func (p *credentialFileProvider) RetrieveWithCredContext(_ *credentials.CredContext) (credentials.Value, error) {
+	if !filepath.IsAbs(p.path) {
+		return credentials.Value{}, fmt.Errorf("temporary S3 credential file must be absolute")
+	}
+
+	info, err := os.Lstat(p.path)
+	if err != nil || !info.Mode().IsRegular() || info.Size() > 65536 {
+		return credentials.Value{}, fmt.Errorf("temporary S3 credentials unavailable")
+	}
+
+	f, err := os.Open(p.path)
+	if err != nil {
+		return credentials.Value{}, fmt.Errorf("temporary S3 credentials unavailable")
+	}
+	defer f.Close() //nolint:errcheck
+
+	var value struct {
+		AccessKeyID     string    `json:"access_key_id"`
+		SecretAccessKey string    `json:"secret_access_key"`
+		SessionToken    string    `json:"session_token"`
+		ExpiresAt       time.Time `json:"expires_at"`
+	}
+
+	decoder := json.NewDecoder(io.LimitReader(f, 65537))
+	if err := decoder.Decode(&value); err != nil {
+		return credentials.Value{}, fmt.Errorf("invalid temporary S3 credentials")
+	}
+
+	if decoder.Decode(new(any)) != io.EOF {
+		return credentials.Value{}, fmt.Errorf("invalid temporary S3 credentials")
+	}
+
+	if value.AccessKeyID == "" || value.SecretAccessKey == "" || value.SessionToken == "" ||
+		!time.Now().Add(5*time.Second).Before(value.ExpiresAt) {
+		return credentials.Value{}, fmt.Errorf("temporary S3 credentials expired or incomplete")
+	}
+
+	return credentials.Value{
+		AccessKeyID: value.AccessKeyID, SecretAccessKey: value.SecretAccessKey,
+		SessionToken: value.SessionToken, SignerType: credentials.SignatureV4,
+	}, nil
+}
+
+// Reload the atomic file on each request. This small local read also makes
+// removal/revocation fail closed immediately, without caching stale identities.
+func (p *credentialFileProvider) IsExpired() bool { return true }
