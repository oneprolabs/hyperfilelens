+package s3
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/minio/minio-go/v7/pkg/credentials"
+)
+
+func TestCredentialFileProviderRefreshesInAnOpenClient(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "credentials.json")
+	write := func(access string, expiry time.Time) {
+		t.Helper()
+		b, err := json.Marshal(map[string]any{
+			"access_key_id": access, "secret_access_key": "test-secret",
+			"session_token": "test-session", "expires_at": expiry,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := os.WriteFile(path+".part", b, 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := os.Rename(path+".part", path); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	// One minio Credentials instance models a long-running Kopia connection.
+	provider := credentials.New(&credentialFileProvider{path: path})
+	write("first-access", time.Now().Add(time.Minute))
+	first, err := provider.Get()
+	if err != nil || first.AccessKeyID != "first-access" || first.SessionToken != "test-session" {
+		t.Fatalf("first identity was not loaded: %v", err)
+	}
+	write("renewed-access", time.Now().Add(time.Minute))
+	second, err := provider.Get()
+	if err != nil || second.AccessKeyID != "renewed-access" {
+		t.Fatalf("identity was not refreshed in the running client: %v", err)
+	}
+	write("expired-access", time.Now().Add(-time.Minute))
+	if _, err := provider.Get(); err == nil {
+		t.Fatal("expired identity accepted")
+	}
+	if err := os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("AWS_ACCESS_KEY_ID", "must-not-fall-back")
+	t.Setenv("AWS_SECRET_ACCESS_KEY", "must-not-fall-back")
+	if _, err := provider.Get(); err == nil {
+		t.Fatal("missing identity fell back to another provider")
+	}
+}
+
+func TestCredentialFileProviderRejectsMalformedContent(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "credentials.json")
+	for _, value := range []string{
+		`{`, `{}`, `{"access_key_id":"a","secret_access_key":"s","session_token":"t"}`,
+		`{"secret_access_key":"must-not-log"} {}`,
+	} {
+		if err := os.WriteFile(path, []byte(value), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := (&credentialFileProvider{path: path}).Retrieve(); err == nil {
+			t.Fatal("malformed credentials accepted")
+		} else if err.Error() == value {
+			t.Fatal("credential data exposed in error")
+		}
+	}
+	if _, err := (&credentialFileProvider{path: "relative.json"}).Retrieve(); err == nil {
+		t.Fatal("relative credential path accepted")
+	}
+}
