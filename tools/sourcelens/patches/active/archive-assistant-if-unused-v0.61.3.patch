+    @action(detail=True, methods=["get", "post"], url_path="archive-if-unused")
+    @transaction.atomic
+    def archive_if_unused(self, request, *args, **kwargs):
+        """Archive only when no active session from any user uses this Assistant."""
+
+        assistant = self.get_object()
+        if request.method == "GET":
+            return Response({"supported": True, "status": assistant.status})
+        # Session creation locks this same Assistant row before inserting.
+        assistant = Assistant.objects.select_for_update().get(pk=assistant.pk)
+        if Session.objects.filter(
+            assistant=assistant,
+            status=Session.Status.ACTIVE,
+        ).exists() or Run.objects.filter(
+            session__assistant=assistant,
+            status__in=(
+                Run.Status.QUEUED,
+                Run.Status.RUNNING,
+                Run.Status.STREAMING,
+                Run.Status.AWAITING_USER_INPUT,
+            ),
+        ).exists():
+            return Response(
+                {"detail": "ASSISTANT_HAS_ACTIVE_SESSIONS"},
+                status=status.HTTP_409_CONFLICT,
+            )
+        if assistant.status != Assistant.Status.ARCHIVED:
+            assistant.status = Assistant.Status.ARCHIVED
+            assistant.save(update_fields=["status", "updated_at"])
+        return Response(self.get_serializer(assistant).data)
+
