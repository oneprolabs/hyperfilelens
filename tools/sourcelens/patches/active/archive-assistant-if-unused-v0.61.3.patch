+    def test_archive_if_unused_blocks_another_users_active_session(self):
+        capability = self.client.get(
+            f"/api/lens/assistants/{self.assistant.uuid}/archive-if-unused/"
+        )
+        self.assertEqual(capability.status_code, 200)
+        self.assertEqual(
+            capability.data, {"supported": True, "status": Assistant.Status.ACTIVE}
+        )
+        other = User.objects.create_user(
+            username="another-session-owner", password="pass12345"
+        )
+        session = Session.objects.create(
+            assistant=self.assistant,
+            user=other,
+            title="External conversation",
+        )
+
+        blocked = self.client.post(
+            f"/api/lens/assistants/{self.assistant.uuid}/archive-if-unused/"
+        )
+        self.assertEqual(blocked.status_code, 409)
+        self.assertEqual(blocked.data["detail"], "ASSISTANT_HAS_ACTIVE_SESSIONS")
+        self.assistant.refresh_from_db()
+        self.assertEqual(self.assistant.status, Assistant.Status.ACTIVE)
+
+        session.status = Session.Status.ARCHIVED
+        session.save(update_fields=["status"])
+        archived = self.client.post(
+            f"/api/lens/assistants/{self.assistant.uuid}/archive-if-unused/"
+        )
+        self.assertEqual(archived.status_code, 200)
+        self.assertEqual(archived.data["status"], Assistant.Status.ARCHIVED)
+        repeated = self.client.post(
+            f"/api/lens/assistants/{self.assistant.uuid}/archive-if-unused/"
+        )
+        self.assertEqual(repeated.status_code, 200)
+
